# Copy to .env (git-ignored) or export these in your shell. Never commit a real key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_MODEL=gemini-3.5-flash-lite   # larger free daily limit
CAMPUS_LANG=en              # en | hi | hinglish
CAMPUS_DAILY_LIMIT=20       # our own safety cap on Gemini calls per day (0 = no cap)
CAMPUS_EMBEDDINGS=0         # 1 = hybrid search with gemini-embedding-2
CAMPUS_TIMETABLE=data/sample/timetable.csv
CAMPUS_FAQ_DIR=data/sample/faq
CAMPUS_NOTES_DIR=data/sample/notes
